#!/bin/bash

here="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}" in
  update|version) exec "$here/harness.sh" "$@" ;;
esac
entry=""
for candidate in "$here/../context-firewall/tbv.py" "$HOME/.tbv/context-firewall/tbv.py"; do
  if [ -f "$candidate" ]; then entry="$candidate"; break; fi
done

python=""
for candidate in "${PYTHON:-}" python3 python py; do
  [ -n "$candidate" ] || continue
  command -v "$candidate" >/dev/null 2>&1 || continue
  if [ "$candidate" = "py" ]; then
    py -3 -c "" >/dev/null 2>&1 && python="py -3" && break
  elif "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    python="$candidate"
    break
  fi
done

if [ -z "$entry" ] || [ -z "$python" ]; then
  if [ "${1:-}" = "hook" ]; then
    cat >/dev/null
    exit 0
  fi
  echo "tbv: needs Python 3.8+ and context-firewall/tbv.py (looked next to $here and in ~/.tbv)" >&2
  exit 127
fi

export TBV_SELF="$here/tbv"
# shellcheck disable=SC2086
exec $python "$entry" "$@"
